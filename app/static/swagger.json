{
  "swagger": "2.0",
  "info": {
    "title": "InvestLink API",
    "description": "API para análise de investimentos brasileiros (ações e FIIs)",
    "version": "1.0.0"
  },
  "host": "localhost:5000",
  "basePath": "/v1",
  "schemes": [
    "http"
  ],
  "securityDefinitions": {
    "Bearer": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "JWT token no formato: Bearer {token}"
    }
  },
  "security": [
    {
      "Bearer": []
    }
  ],
  "tags": [
    {
      "name": "Stocks",
      "description": "Ações da bolsa"
    },
    {
      "name": "FIIs",
      "description": "Fundos de Investimento Imobiliário"
    },
    {
      "name": "Users",
      "description": "Usuários e autenticação"
    },
    {
      "name": "Favorites",
      "description": "Ações favoritas"
    },
    {
      "name": "FII Favorites",
      "description": "FIIs favoritos"
    },
    {
      "name": "Portfolio",
      "description": "Carteira de investimentos"
    },
    {
      "name": "Predictions",
      "description": "Previsões do modelo ML"
    },
    {
      "name": "User Layout",
      "description": "Preferências de layout da tabela"
    },
    {
      "name": "Opportunities",
      "description": "Score fundamentalista e vitrine de oportunidades"
    }
  ],
  "paths": {
    "/stocks": {
      "get": {
        "tags": [
          "Stocks"
        ],
        "summary": "Lista todas as ações",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "type": "integer",
            "default": 1
          },
          {
            "name": "per_page",
            "in": "query",
            "type": "integer",
            "default": 50
          },
          {
            "name": "sort_by",
            "in": "query",
            "type": "string",
            "description": "Qualquer coluna da tabela, mais score_total (exige o join com stock_scores, feito automaticamente)"
          },
          {
            "name": "sort_dir",
            "in": "query",
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ]
          },
          {
            "name": "filters",
            "in": "query",
            "type": "string",
            "description": "JSON array de filtros"
          },
          {
            "name": "search",
            "in": "query",
            "type": "string",
            "description": "Busca por ticker ou nome da empresa"
          },
          {
            "name": "profile",
            "in": "query",
            "type": "string",
            "default": "EQUILIBRADO",
            "description": "Perfil de pesos do score; também habilita sort_by=score_total"
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de ações com paginação"
          }
        }
      },
      "post": {
        "tags": [
          "Stocks"
        ],
        "summary": "Cria uma nova ação",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Ação criada"
          }
        }
      }
    },
    "/stock/{ticker}": {
      "get": {
        "tags": [
          "Stocks"
        ],
        "summary": "Retorna dados de uma ação",
        "parameters": [
          {
            "name": "ticker",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Dados da ação com previsão ML"
          },
          "404": {
            "description": "Ação não encontrada"
          }
        }
      },
      "put": {
        "tags": [
          "Stocks"
        ],
        "summary": "Atualiza uma ação",
        "parameters": [
          {
            "name": "ticker",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ação atualizada"
          }
        }
      },
      "delete": {
        "tags": [
          "Stocks"
        ],
        "summary": "Remove uma ação",
        "parameters": [
          {
            "name": "ticker",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Ação removida"
          }
        }
      }
    },
    "/stocks/update-stocks": {
      "put": {
        "tags": [
          "Stocks"
        ],
        "summary": "Sincroniza ações do StatusInvest (somente ADMIN)",
        "responses": {
          "200": {
            "description": "Ações atualizadas"
          }
        }
      }
    },
    "/stocks/predictions": {
      "get": {
        "tags": [
          "Predictions"
        ],
        "summary": "Lista as últimas previsões ML de todas as ações",
        "responses": {
          "200": {
            "description": "Lista de previsões"
          }
        },
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "type": "integer",
            "default": 1
          },
          {
            "name": "per_page",
            "in": "query",
            "type": "integer",
            "default": 200
          }
        ]
      }
    },
    "/stocks/{ticker}/prediction": {
      "get": {
        "tags": [
          "Predictions"
        ],
        "summary": "Retorna a previsão ML de uma ação específica",
        "parameters": [
          {
            "name": "ticker",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Previsão ML"
          },
          "404": {
            "description": "Previsão não encontrada"
          }
        }
      }
    },

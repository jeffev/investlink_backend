    "/stocks/reconciliation": {
      "get": {
        "tags": [
          "Stocks"
        ],
        "summary": "Confronta o fundamento da CVM com o do StatusInvest",
        "description": "Rede de segurança de quem aposentou o scraper: compara LPA, VPA e ROE do exercício fechado entre as duas fontes e lista quem diverge acima de 10%. Busca o StatusInvest na hora, porque a tabela stocks já foi sobrescrita pelo valor auditado. Divergência não significa erro da CVM — significa que alguém precisa olhar. Somente ADMIN.",
        "parameters": [
          {
            "name": "year",
            "in": "query",
            "type": "integer",
            "description": "Exercício a comparar; por padrão o último fechado"
          }
        ],
        "responses": {
          "200": {
            "description": "Relatório de divergências"
          },
          "409": {
            "description": "Sem demonstrações da CVM para o ano pedido"
          },
          "502": {
            "description": "StatusInvest indisponível"
          }
        }
      }
    },
    "/opportunities/backtest": {
      "get": {
        "tags": [
          "Opportunities"
        ],
        "summary": "Como o decil de topo do score se saiu em cada ano",
        "description": "Pontua cada ano com os múltiplos DAQUELE ano — pontuar 2021 com o score de hoje seria look-ahead e daria um resultado espetacular e falso. Compara o decil de topo com a média igualmente ponderada do próprio universo. A resposta carrega as ressalvas em `caveats`, incluindo o viés de sobrevivência: quem quebrou e saiu da bolsa não está em lado nenhum da conta.",
        "parameters": [
          {
            "name": "profile",
            "in": "query",
            "type": "string",
            "default": "EQUILIBRADO"
          }
        ],
        "responses": {
          "200": {
            "description": "Resultado por ano, resumo e ressalvas"
          },
          "400": {
            "description": "Perfil desconhecido"
          },
          "409": {
            "description": "Sem histórico de múltiplos derivado"
          }
        }
      }
    }
